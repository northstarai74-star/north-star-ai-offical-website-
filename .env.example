# Airtable Configuration
# To point the booking form at a different Airtable base/table (or a
# different Airtable account entirely), just change these three values
# and restart the server. No code changes needed.
AIRTABLE_API_KEY=your_airtable_api_key_here
AIRTABLE_BASE_ID=your_airtable_base_id_here
AIRTABLE_TABLE_ID=your_airtable_table_id_here

# Airtable column names (optional)
# Only change these if your base/table uses different column names than
# the defaults below. Uncomment and edit as needed. If a column name has
# a trailing space, wrap the value in double quotes (as shown) so it's
# preserved - unquoted trailing spaces get stripped.
# AIRTABLE_FIELD_CLINIC_NAME="Clinic Name"
# AIRTABLE_FIELD_CONTACT_PERSON="Name "
# AIRTABLE_FIELD_EMAIL="Email"
# AIRTABLE_FIELD_PHONE="Phone number "
# AIRTABLE_FIELD_LOCATION="location "

# Optional: restrict CORS to a specific origin (e.g. https://northstarai.co.uk)
# Leave unset to disable cross-origin requests entirely
ALLOWED_ORIGIN=

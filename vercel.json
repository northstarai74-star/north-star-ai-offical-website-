{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "*.@(html|svg|txt|xml)", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/save-booking", "dest": "/api/save-booking.js" },
    { "src": "/", "dest": "/index.html" },
    { "handle": "filesystem" }
  ]
}
